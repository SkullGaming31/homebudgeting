{
  "name": "home-budgeting",
  "version": "1.0.1",
  "description": "Home Budgeting Electron app (TypeScript)",
  "main": "dist/main.js",
  "scripts": {
    "build:main": "tsc",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dev:renderer": "vite",
    "dev:main": "tsc -w",
    "test": "npm run build:main && node --test tests/*.test.cjs"
  },
  "keywords": [],
  "author": "SkullGaming31",
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.7"
  },
  "build": {
    "appId": "com.skullgaming31.homebudgeting",
    "productName": "Home Budgeting",
    "artifactName": "Home-Budgeting-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Home Budgeting"
    }
  }
}